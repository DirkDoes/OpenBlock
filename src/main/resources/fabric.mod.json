{
	"schemaVersion": 1,
	"id": "openblock",
	"version": "${version}",
	"name": "OpenBlock",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/openblock/icon.png",
	"environment": "*",
	"entrypoints": {
		"server": [
			{
				"value": "me.wanttobee.openblock.OpenBlock",
				"adapter": "kotlin"
			}
		],
		"fabric-datagen": [
			{
				"value": "me.wanttobee.openblock.OpenBlockDataGenerator",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"openblock.mixins.json",
		{
			"config": "openblock.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.5",
		"minecraft": "~26.1",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}
